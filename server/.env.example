PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=careertrack

# JWT configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=5
